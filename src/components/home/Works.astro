---
import { getContent } from "../../i18n/content";
import { localePath, type Locale } from "../../i18n/locales";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { products, ui: t } = getContent(locale);
const works = products.map((p) => ({
  ...p,
  href: p.slug ? localePath(locale, `/products/${p.slug}/`) : null,
  alt: p.slug ? t.workPhotoAlt.replace("{name}", p.name) : t.comingSoonAlt,
}));
---

<section id="works" class="section reveal" aria-labelledby="works-title">
  <p class="eyebrow">{t.worksEyebrow}</p>
  <h2 id="works-title" class="section-title">{t.worksTitle}</h2>
  <ul class="grid">
    {
      works.map((w) => (
        <li>
          <article class="work-card" data-slug={w.slug ?? undefined}>
            <div class="frame">
              <img
                src={w.img}
                alt={w.alt}
                width="1000"
                height="750"
                loading="lazy"
                decoding="async"
              />
            </div>
            <h3>
              {w.href ? <a href={w.href}>{w.name}</a> : <span>{w.name}</span>}
            </h3>
            <p>{w.desc}</p>
            {w.href && (
              <span class="more" aria-hidden="true">
                {t.viewDetails}
                <svg
                  viewBox="0 0 24 24"
                  width="16"
                  height="16"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.75"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M5 12h14M13 6l6 6-6 6" />
                </svg>
              </span>
            )}
          </article>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .grid {
    display: grid;
    gap: 56px;
    margin: 48px 0 0;
    padding: 0;
    list-style: none;
  }
  .work-card {
    position: relative;
  }
  .frame {
    overflow: hidden;
    aspect-ratio: 4 / 3;
    border-radius: var(--radius);
    background: var(--surface);
  }
  .frame img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }
  h3 {
    margin: 20px 0 0;
    font-size: clamp(22px, 2.4vw, 28px);
  }
  h3 a {
    color: var(--text);
    text-decoration: none;
  }
  /* The name link covers the whole card, so the image and text are one target. */
  h3 a::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: var(--radius);
  }
  h3 a:focus-visible {
    outline: none;
  }
  h3 a:focus-visible::after {
    outline: 2px solid var(--accent);
    outline-offset: 6px;
  }
  p {
    max-width: 52ch;
    margin: 8px 0 0;
    color: var(--muted);
  }
  .more {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 16px;
    color: var(--text);
    font-size: 15px;
    font-weight: 500;
  }
  .more svg {
    transition: transform 0.4s ease;
  }
  .work-card:hover .frame img {
    transform: scale(1.03);
  }
  .work-card:hover .more svg {
    transform: translateX(3px);
  }
  @media (min-width: 900px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 72px 48px;
      margin-top: 64px;
    }
  }
</style>
