---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getContent } from "../i18n/content";
import type { Locale } from "../i18n/locales";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const c = getContent(locale).shipping;
const quoted = getContent(locale).ui.quotedPerOrder;
---

<BaseLayout
  locale={locale}
  path="/shipping/"
  title={`${c.title} · Timond Lab`}
  description={c.intro}
>
  <article class="page">
    <h1>{c.title}</h1>
    <p class="lead">{c.intro}</p>

    <div class="table-wrap">
      <table class="rates">
        <thead>
          <tr><th>{c.regionCol}</th><th>{c.timeCol}</th><th>{c.costCol}</th></tr
          >
        </thead>
        <tbody>
          {
            c.regions.map((r) => (
              <tr>
                <td>{r.name}</td>
                <td>{r.days ?? quoted}</td>
                <td>{r.cost}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <h2>{c.dutiesTitle}</h2>
    <p>{c.dutiesNotice}</p>

    <h2>{c.returnsTitle}</h2>
    <p>{c.returnsNotice}</p>
  </article>
</BaseLayout>

<style>
  .page {
    max-width: 760px;
    margin: 0 auto;
    padding: 48px var(--gutter) 0;
  }
  h1 {
    margin: 0 0 16px;
    font-size: clamp(34px, 6vw, 56px);
  }
  h2 {
    margin: 48px 0 12px;
    font-size: clamp(22px, 3vw, 28px);
  }
  .lead {
    margin: 0 0 40px;
    color: var(--muted);
    font-size: 18px;
  }
  .table-wrap {
    overflow-x: auto;
  }
  .rates {
    width: 100%;
    border-collapse: collapse;
  }
  .rates th,
  .rates td {
    padding: 14px 12px 14px 0;
    border-bottom: 1px solid var(--border);
    text-align: left;
    vertical-align: top;
  }
  .rates th {
    color: var(--muted);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  p {
    color: var(--muted);
  }
</style>
