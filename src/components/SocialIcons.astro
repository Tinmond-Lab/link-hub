---
import { getContent, type Social } from "../i18n/content";
import type { Locale } from "../i18n/locales";
import { socialBrand } from "./social-brand";
import MailIcon from "./MailIcon.astro";

interface Props {
  locale: Locale;
  /** Channels to leave out (the footer already shows the email as text). */
  omit?: Social["key"][];
}

const { locale, omit = [] } = Astro.props;
const socials = getContent(locale)
  .socials.filter((s) => !omit.includes(s.key))
  .map((s) => ({
    ...s,
    path: socialBrand(s.key).path,
    external: !s.href.startsWith("mailto:"),
  }));
---

<ul class="social-icons">
  {
    socials.map((s) => (
      <li>
        <a
          href={s.href}
          aria-label={s.name}
          {...(s.external ? { target: "_blank", rel: "noopener" } : {})}
        >
          {s.path ? (
            <svg
              viewBox="0 0 24 24"
              width="18"
              height="18"
              fill="currentColor"
              aria-hidden="true"
            >
              <path d={s.path} />
            </svg>
          ) : (
            <MailIcon size={20} />
          )}
        </a>
      </li>
    ))
  }
</ul>

<style>
  .social-icons {
    display: flex;
    flex-wrap: wrap;
    gap: 2px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 6px;
    color: var(--muted);
    transition: color 0.2s ease;
  }
  a:hover {
    color: var(--text);
  }
</style>
