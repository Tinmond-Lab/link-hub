---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getContent } from "../i18n/content";
import ContactButtons from "./ContactButtons.astro";
import type { Locale } from "../i18n/locales";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const c = getContent(locale).commission;
---

<BaseLayout
  locale={locale}
  path="/commission/"
  title={`${c.title} · Timond Lab`}
  description={c.intro}
>
  <article class="page">
    <h1>{c.title}</h1>
    <p class="lead">{c.intro}</p>

    <h2>{c.stepsTitle}</h2>
    <ol class="steps">
      {
        c.steps.map((s) => (
          <li class="step">
            <strong>{s.title}</strong>
            <span>{s.text}</span>
          </li>
        ))
      }
    </ol>

    <h2>{c.includeTitle}</h2>
    <ul class="include">
      {c.include.map((item) => <li>{item}</li>)}
    </ul>

    <div class="contact">
      <ContactButtons locale={locale} />
    </div>
  </article>
</BaseLayout>

<style>
  .contact {
    margin-top: 32px;
  }
  .page {
    max-width: 760px;
    margin: 0 auto;
    padding: 48px var(--gutter) 0;
  }
  h1 {
    margin: 0 0 16px;
    font-size: clamp(34px, 6vw, 56px);
  }
  h2 {
    margin: 56px 0 20px;
    font-size: clamp(22px, 3vw, 28px);
  }
  .lead {
    margin: 0;
    color: var(--muted);
    font-size: 18px;
  }
  .steps {
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: step;
  }
  .step {
    display: grid;
    grid-template-columns: 48px 1fr;
    column-gap: 16px;
    padding: 20px 0;
    border-top: 1px solid var(--border);
    counter-increment: step;
  }
  .step:last-child {
    border-bottom: 1px solid var(--border);
  }
  .step::before {
    content: counter(step, decimal-leading-zero);
    grid-row: span 2;
    color: var(--accent);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.14em;
    line-height: 1.9;
  }
  .step strong {
    font-family: var(--font-heading);
    font-size: 18px;
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  .step span {
    color: var(--muted);
  }
  .include {
    margin: 0 0 40px;
    padding-left: 20px;
    color: var(--muted);
  }
  .include li {
    margin-bottom: 8px;
  }
  .include li::marker {
    color: var(--accent);
  }
</style>
