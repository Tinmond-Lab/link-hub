---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getContent } from "../i18n/content";
import { productJsonLd } from "../seo/jsonld";
import { SITE_URL, localePath, type Locale } from "../i18n/locales";

interface Props {
  locale: Locale;
  slug: string;
}

const { locale, slug } = Astro.props;
const t = getContent(locale).ui;
const product = getContent(locale).products.find((p) => p.slug === slug)!;
const subject = encodeURIComponent(`${t.enquirySubject}: ${product.name}`);
const price =
  product.priceUsd === null ? t.priceOnRequest : `$${product.priceUsd} USD`;
---

<BaseLayout
  locale={locale}
  path={`/products/${slug}/`}
  title={`${product.name} · Timond Lab`}
  description={product.desc}
  image={`${SITE_URL}${product.img}`}
  jsonLd={[productJsonLd(locale, product)]}
>
  <article class="product">
    <div class="frame">
      <img
        src={product.img}
        alt={product.name}
        width={product.imgWidth}
        height={product.imgHeight}
        fetchpriority="high"
      />
    </div>
    <div class="details">
      <h1>{product.name}</h1>
      <p class="lead">{product.desc}</p>
      <div class="facts">
        <div><strong>{t.priceLabel}:</strong> {price}</div>
        <div>
          <strong>{t.leadTimeLabel}:</strong>{" "}
          {product.leadTime ?? t.quotedPerOrder}
        </div>
      </div>
      <p>
        <a
          class="btn btn-primary"
          href={`mailto:timondlab@gmail.com?subject=${subject}`}
          >{t.productEnquire}</a
        >
      </p>
      <p class="more">
        <a href={localePath(locale, "/shipping/")}>{t.shippingLink}</a>{" "}
        ·{" "}
        <a href={localePath(locale, "/commission/")}>{t.commissionLink}</a>
      </p>
    </div>
  </article>
</BaseLayout>

<style>
  .product {
    display: grid;
    gap: 32px;
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 32px var(--gutter) 0;
  }
  .frame {
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--surface);
  }
  .frame img {
    display: block;
    width: 100%;
    height: auto;
  }
  h1 {
    margin: 0 0 16px;
    font-size: clamp(32px, 5vw, 48px);
  }
  .lead {
    margin: 0 0 28px;
    color: var(--muted);
    font-size: 18px;
  }
  .facts {
    display: grid;
    gap: 10px;
    margin: 0 0 28px;
    padding: 20px 0;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }
  .facts strong {
    color: var(--muted);
    font-weight: 500;
  }
  .more {
    margin-top: 24px;
    color: var(--muted);
    font-size: 15px;
  }
  .more a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
  @media (min-width: 900px) {
    .product {
      grid-template-columns: 3fr 2fr;
      align-items: start;
      gap: 56px;
      padding-top: 48px;
    }
    .details {
      position: sticky;
      top: 96px;
    }
  }
</style>
