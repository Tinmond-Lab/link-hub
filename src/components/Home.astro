---
import {
  siYoutube,
  siTiktok,
  siFacebook,
  siInstagram,
  siShopee,
  siZalo,
} from "simple-icons";
import iconCode from "lucide-static/icons/code.svg?raw";
import iconCuboid from "lucide-static/icons/cuboid.svg?raw";
import iconPaintbrush from "lucide-static/icons/paintbrush.svg?raw";
import iconLayers from "lucide-static/icons/layers.svg?raw";
import HeadMeta from "./HeadMeta.astro";
import { getContent } from "../i18n/content";
import { jsonLdScript, organizationJsonLd } from "../seo/jsonld";
import { localePath, otherLocale, type Locale } from "../i18n/locales";

const { locale } = Astro.props as { locale: Locale };
const c = getContent(locale);
const t = c.ui;

const brand = {
  youtube: { color: `#${siYoutube.hex}`, path: siYoutube.path },
  tiktok: { color: "var(--text)", path: siTiktok.path },
  facebook: { color: `#${siFacebook.hex}`, path: siFacebook.path },
  instagram: { color: `#${siInstagram.hex}`, path: siInstagram.path },
  shopee: { color: `#${siShopee.hex}`, path: siShopee.path },
  zalo: { color: `#${siZalo.hex}`, path: siZalo.path },
  email: { color: "var(--accent)", path: null },
} as const;
const socials = c.socials.map((s) => ({ ...s, ...brand[s.key] }));
const serviceIcons = {
  code: iconCode,
  cuboid: iconCuboid,
  paintbrush: iconPaintbrush,
  layers: iconLayers,
};
---

<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#1677ff" />
    <HeadMeta locale={locale} />
    <script
      type="application/ld+json"
      set:html={jsonLdScript(organizationJsonLd(locale))}
    />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link
      href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="topbar">
      <div class="search-box">
        <span class="search-icon">⌕</span>
        <input
          id="search-input"
          class="search-input"
          type="text"
          placeholder={t.searchPlaceholder}
        />
      </div>
      <div class="topbar-actions">
        <a
          id="lang-toggle"
          class="pill-btn"
          href={localePath(otherLocale(locale))}
          hreflang={otherLocale(locale)}
          aria-label={t.langAria}>{t.langLabel}</a
        >
        <button
          id="theme-toggle"
          class="pill-btn icon-btn"
          type="button"
          aria-label={t.themeAria}>☾</button
        >
      </div>
    </div>

    <div class="container">
      <section class="hero" data-screen-label="Hero">
        <div class="hero-avatar-wrap">
          <div class="hero-avatar">
            <img
              src="/avatar.webp"
              alt={t.avatarAlt}
              width="128"
              height="128"
            />
          </div>
        </div>
        <div class="hero-brand">Timond Lab</div>
        <h1 class="hero-title">Build Ideas Into Reality</h1>
        <div class="hero-subtitle">{c.hero.subtitle}</div>
        <div class="hero-ctas">
          {
            c.hero.ctas.map((cta) => (
              <a href={cta.href} class={`btn btn-${cta.variant}`}>
                {cta.label}
              </a>
            ))
          }
        </div>
      </section>

      <section
        class="section reveal"
        data-reveal="about"
        data-screen-label="About"
      >
        <div class="about-card">
          <div class="eyebrow">{t.aboutEyebrow}</div>
          <div class="about-body">
            <p>{t.aboutBody}</p>
          </div>
        </div>
      </section>

      <section
        id="social"
        class="section reveal"
        data-reveal="social"
        data-screen-label="Social Links"
      >
        <h2 class="section-title">{t.socialTitle}</h2>
        <div class="social-list">
          {
            socials.map((s, i) => (
              <a
                href={s.href}
                target="_blank"
                rel="noopener"
                class="social-item"
                data-filter={`${s.name} ${s.handle}`.toLowerCase()}
                style={`--i:${i}`}
              >
                <div
                  class="social-icon"
                  style={`background:color-mix(in srgb, ${s.color} 12%, transparent)`}
                >
                  {s.path ? (
                    <svg
                      viewBox="0 0 24 24"
                      width="18"
                      height="18"
                      fill={s.color}
                    >
                      <path d={s.path} />
                    </svg>
                  ) : (
                    <svg
                      viewBox="0 0 24 24"
                      width="20"
                      height="20"
                      fill="none"
                      stroke={s.color}
                      stroke-width="2"
                      stroke-linejoin="round"
                      stroke-linecap="round"
                    >
                      <rect x="3" y="5" width="18" height="14" rx="2" />
                      <path d="M4 7l8 6 8-6" />
                    </svg>
                  )}
                </div>
                <div class="social-text">
                  <div class="social-name">{s.name}</div>
                  <div class="social-handle">{s.handle}</div>
                </div>
                <div class="social-chevron">›</div>
              </a>
            ))
          }
        </div>
        <p class="no-results" data-role="social-empty" hidden>{t.noResults}</p>
      </section>

      <section
        id="products"
        class="section reveal"
        data-reveal="products"
        data-screen-label="Products"
      >
        <h2 class="section-title">{t.productsTitle}</h2>
        <div class="products-grid">
          {
            c.products.map((p, i) => (
              <div
                class="product-card"
                data-filter={p.name.toLowerCase()}
                style={`--i:${i}`}
              >
                <div class="product-image placeholder" data-slot={p.slotId}>
                  <span class="placeholder-icon" aria-hidden="true">
                    🖼
                  </span>
                  <span class="placeholder-label">{p.name}</span>
                  <img
                    src={p.img}
                    alt={p.name}
                    loading="lazy"
                    onerror="this.remove()"
                  />
                </div>
                <div class="product-body">
                  <div class="product-name">{p.name}</div>
                  <div class="product-desc">{p.desc}</div>
                  {p.slug && (
                    <a
                      href={localePath(locale, `/products/${p.slug}/`)}
                      class="product-link"
                    >
                      {t.viewDetails}
                    </a>
                  )}
                </div>
              </div>
            ))
          }
        </div>
        <p class="no-results" data-role="products-empty" hidden>
          {t.noResults}
        </p>
      </section>

      <section
        id="journey"
        class="section reveal"
        data-reveal="journey"
        data-screen-label="Journey"
      >
        <h2 class="section-title">{t.journeyTitle}</h2>
        <div class="journey-wrap">
          <div id="journey-track" class="journey-track">
            <div id="journey-runner" class="journey-runner"></div>
            {
              c.journeySteps.map((step, i) => (
                <div class="journey-step" style={`--i:${i}`} data-step={i}>
                  {i < c.journeySteps.length - 1 && (
                    <div class="journey-line" />
                  )}
                  <div class="journey-badge">{i + 1}</div>
                  <div class="journey-label">{step}</div>
                </div>
              ))
            }
          </div>
          <div class="fade-edge fade-edge-left"></div>
          <div class="fade-edge fade-edge-right"></div>
        </div>
      </section>

      <section
        class="section reveal"
        data-reveal="buildpublic"
        data-screen-label="Build in Public"
      >
        <h2 class="section-title" style="margin-bottom:4px">{t.bipTitle}</h2>
        <div class="section-sub">{t.bipSub}</div>
        <div class="buildpublic-grid">
          {
            c.buildPublic.map((v, i) => (
              <div class="bip-card" style={`--i:${i}`}>
                <div class="bip-image placeholder" data-slot={v.slotId}>
                  <span class="placeholder-icon" aria-hidden="true">
                    🖼
                  </span>
                  {v.img && (
                    <img
                      src={v.img}
                      alt={v.label}
                      loading="lazy"
                      onerror="this.remove()"
                    />
                  )}
                </div>
                <div class="bip-label">{v.label}</div>
              </div>
            ))
          }
        </div>
      </section>

      <section
        class="section reveal"
        data-reveal="services"
        data-screen-label="Services"
      >
        <h2 class="section-title">{t.servicesTitle}</h2>
        <div class="services-grid">
          {
            c.services.map((sv, i) => (
              <div class="service-card" style={`--i:${i}`}>
                <div class="service-icon" set:html={serviceIcons[sv.key]} />
                <div class="service-label">{sv.label}</div>
              </div>
            ))
          }
        </div>
      </section>

      <section
        class="section reveal"
        data-reveal="values"
        data-screen-label="Values"
      >
        <h2 class="section-title">{t.valuesTitle}</h2>
        <div class="values-grid">
          {
            c.values.map((val, i) => (
              <div class="value-item" style={`--i:${i}`}>
                <div class="value-check">
                  <svg
                    viewBox="0 0 24 24"
                    width="15"
                    height="15"
                    fill="none"
                    stroke="#fff"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <polyline points="5,13 10,18 19,7" />
                  </svg>
                </div>
                <div class="value-label">{val}</div>
              </div>
            ))
          }
        </div>
      </section>

      <section class="section reveal" data-reveal="faq" data-screen-label="FAQ">
        <h2 class="section-title">{t.faqTitle}</h2>
        <div class="faq-list">
          {
            c.faq.map((item, i) => (
              <details class="faq-item" style={`--i:${i}`}>
                <summary class="faq-question">
                  <span class="faq-question-text">{item.q}</span>
                  <span class="faq-icon" aria-hidden="true">
                    +
                  </span>
                </summary>
                <div class="faq-answer">
                  {item.a}
                  {item.link && (
                    <>
                      {" "}
                      <a href={localePath(locale, item.link.path)}>
                        {item.link.label}
                      </a>
                    </>
                  )}
                </div>
              </details>
            ))
          }
        </div>
      </section>
    </div>

    <div class="closing-wrap">
      <div class="closing-card">
        <div class="closing-title">{t.closingTitle}</div>
        <div class="closing-sub">{t.closingSub}</div>
        <a href="#social" class="btn btn-primary">{t.closingCta}</a>
      </div>
    </div>

    <footer class="footer">
      <div class="footer-copy">
        © 2026 Timond Lab · Designed by Nguyễn Hoàng Tín
      </div>
    </footer>

    <button
      id="back-to-top"
      class="back-to-top"
      type="button"
      aria-label={t.backToTop}
      hidden>↑</button
    >
  </body>
</html>

<style>
  :root {
    --bg: #f5f7fa;
    --surface: #ffffff;
    --bar-bg: rgba(245, 247, 250, 0.8);
    --text: #0f172a;
    --muted: #64748b;
    --border: #e3e7ed;
    --accent: #1677ff;
    --chip: #eaf2ff;
  }
  :root[data-theme="dark"] {
    --bg: #0f172a;
    --surface: #182238;
    --bar-bg: rgba(15, 23, 42, 0.75);
    --text: #f5f7fa;
    --muted: #94a3b8;
    --border: rgba(217, 217, 217, 0.14);
    --accent: #4c9aff;
    --chip: rgba(76, 154, 255, 0.14);
  }

  * {
    box-sizing: border-box;
  }
  html {
    scroll-behavior: smooth;
  }
  body {
    margin: 0;
    font-family:
      "Be Vietnam Pro",
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      sans-serif;
    background: var(--bg);
    color: var(--text);
    transition:
      background 0.25s ease,
      color 0.25s ease;
  }
  ::selection {
    background: var(--accent);
    color: #fff;
  }
  a {
    color: inherit;
  }

  @keyframes fadeUp {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .topbar {
    position: sticky;
    top: 0;
    z-index: 50;
    display: flex;
    align-items: center;
    gap: clamp(8px, 3vw, 16px);
    padding: 10px clamp(12px, 4vw, 24px);
    background: var(--bar-bg);
    backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--border);
  }
  .search-box {
    flex: 1;
    min-width: 0;
    max-width: 360px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    gap: 8px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 11px 14px;
    transition: border-color 0.2s ease;
  }
  .search-box:focus-within {
    border-color: var(--accent);
  }
  .search-icon {
    opacity: 0.5;
    font-size: 13px;
    flex-shrink: 0;
  }
  .search-input {
    border: none;
    outline: none;
    background: transparent;
    color: var(--text);
    font-size: 13px;
    width: 100%;
    min-width: 0;
    font-family: inherit;
  }
  .search-input::placeholder {
    color: inherit;
    opacity: 0.5;
  }
  .topbar-actions {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-shrink: 0;
  }
  .pill-btn {
    cursor: pointer;
    text-decoration: none;
    font: inherit;
    font-size: 12px;
    font-weight: 700;
    padding: 0 12px;
    height: 40px;
    min-width: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--text);
    transition:
      transform 0.2s ease,
      border-color 0.2s ease;
  }
  .pill-btn:hover {
    transform: translateY(-1px);
    border-color: var(--accent);
  }
  .icon-btn {
    font-size: 15px;
    transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .icon-btn:hover {
    transform: rotate(25deg) scale(1.08);
  }

  .container {
    max-width: 880px;
    margin: 0 auto;
    padding: 0 clamp(16px, 5vw, 24px) 80px;
  }

  .hero {
    text-align: center;
    padding: clamp(40px, 10vw, 64px) 0 40px;
  }
  .hero-avatar-wrap {
    width: clamp(96px, 28vw, 128px);
    height: clamp(96px, 28vw, 128px);
    margin: 0 auto 24px;
    position: relative;
  }
  .hero-avatar {
    width: 100%;
    height: 100%;
    border-radius: 999px;
    border: 3px solid var(--surface);
    box-shadow: 0 8px 30px rgba(15, 23, 42, 0.12);
    overflow: hidden;
    animation: fadeUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) both;
  }
  .hero-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .hero-brand {
    font-size: clamp(20px, 5vw, 26px);
    font-weight: 800;
    letter-spacing: -0.5px;
    animation: fadeUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) 0.08s both;
  }
  .hero-title {
    font-size: clamp(28px, 8vw, 40px);
    line-height: 1.15;
    font-weight: 800;
    letter-spacing: -1px;
    margin: 22px 0 10px;
    color: var(--accent);
    animation: fadeUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) 0.16s both;
  }
  .hero-subtitle {
    font-size: 15px;
    color: var(--muted);
    max-width: 520px;
    margin: 0 auto;
    animation: fadeUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) 0.24s both;
  }
  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    justify-content: center;
    margin-top: 28px;
    animation: fadeUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) 0.32s both;
  }
  .btn {
    text-decoration: none;
    padding: 14px 24px;
    border-radius: 999px;
    font-weight: 700;
    font-size: 14px;
    flex: 1 1 160px;
    text-align: center;
    transition:
      transform 0.2s ease,
      opacity 0.2s ease,
      border-color 0.2s ease;
    border: 1px solid transparent;
    display: inline-block;
  }
  .btn-primary {
    background: var(--accent);
    color: #fff;
    border-color: var(--accent);
  }
  .btn-primary:hover {
    opacity: 0.88;
    transform: translateY(-2px);
  }
  .btn-secondary {
    background: var(--surface);
    color: var(--text);
    border-color: var(--border);
  }
  .btn-secondary:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
  }

  .section {
    padding: 32px 0;
  }
  .reveal {
    opacity: 0;
    transform: translateY(28px);
    transition:
      opacity 0.7s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .reveal.is-visible {
    opacity: 1;
    transform: translateY(0);
  }
  .section-title {
    font-size: clamp(26px, 6vw, 34px);
    font-weight: 800;
    letter-spacing: -0.8px;
    margin: 0 0 20px;
  }
  .section-sub {
    font-size: 13px;
    color: var(--muted);
    margin-bottom: 16px;
  }
  .eyebrow {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 10px;
  }

  .about-card {
    border-radius: 20px;
    background: var(--surface);
    border: 1px solid var(--border);
    padding: 28px 26px;
  }
  .about-body {
    font-size: 15px;
    line-height: 1.7;
    color: var(--text);
    text-wrap: pretty;
  }
  .about-body p {
    margin: 0;
  }

  .social-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .social-item {
    text-decoration: none;
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 12px 18px;
    border-radius: 999px;
    background: var(--surface);
    border: 1px solid var(--border);
    color: var(--text);
    box-shadow: 0 2px 10px rgba(15, 23, 42, 0.05);
    transition:
      box-shadow 0.2s ease,
      transform 0.2s ease;
    animation: fadeUp 0.5s ease both;
    animation-delay: calc(var(--i) * 55ms);
  }
  .social-item:hover {
    box-shadow: 0 8px 20px rgba(15, 23, 42, 0.1);
    transform: translateY(-2px);
  }
  .social-icon {
    width: 44px;
    height: 44px;
    border-radius: 999px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .social-text {
    min-width: 0;
    flex: 1;
  }
  .social-name {
    font-weight: 700;
    font-size: 14.5px;
  }
  .social-handle {
    font-size: 12.5px;
    color: var(--muted);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .social-chevron {
    opacity: 0.35;
    font-size: 18px;
    flex-shrink: 0;
  }
  .no-results {
    text-align: center;
    padding: 20px;
    color: var(--muted);
    font-size: 13px;
  }

  .products-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 16px;
  }
  .product-card {
    border-radius: 16px;
    background: var(--surface);
    border: 1px solid var(--border);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: box-shadow 0.25s ease;
    animation: fadeUp 0.5s ease both;
    animation-delay: calc(var(--i) * 55ms);
  }
  .product-card:hover {
    box-shadow: 0 10px 24px rgba(15, 23, 42, 0.1);
  }
  .product-image {
    width: 100%;
    aspect-ratio: 4 / 3;
    position: relative;
  }
  .product-image img,
  .bip-image img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .placeholder {
    background: var(--chip);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 6px;
    color: var(--muted);
    border-bottom: 1px dashed var(--border);
  }
  .placeholder-icon {
    font-size: 26px;
    opacity: 0.6;
  }
  .placeholder-label {
    font-size: 11px;
    text-align: center;
    padding: 0 8px;
  }
  .product-body {
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    flex: 1;
  }
  .product-name {
    font-weight: 700;
    font-size: 14.5px;
  }
  .product-desc {
    font-size: 12.5px;
    color: var(--muted);
    line-height: 1.5;
    flex: 1;
  }
  .product-link {
    margin-top: 8px;
    text-align: center;
    text-decoration: none;
    font-size: 12.5px;
    font-weight: 700;
    padding: 13px;
    border-radius: 999px;
    border: 1px solid var(--border);
    color: var(--text);
    transition:
      border-color 0.2s ease,
      color 0.2s ease;
  }
  .product-link:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .journey-wrap {
    position: relative;
  }
  .journey-track {
    display: flex;
    gap: 0;
    position: relative;
    overflow-x: auto;
    padding: 14px 0 8px;
    scrollbar-width: none;
    scroll-snap-type: x proximity;
  }
  .journey-track::-webkit-scrollbar {
    display: none;
  }
  .journey-runner {
    position: absolute;
    top: 23px;
    left: 0;
    width: 14px;
    height: 14px;
    border-radius: 999px;
    background: var(--accent);
    box-shadow: 0 0 10px var(--accent);
    pointer-events: none;
    z-index: 0;
    transition: left 0.8s ease-in-out;
  }
  .journey-step {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    flex: 1;
    min-width: clamp(64px, 20vw, 88px);
    gap: 8px;
    position: relative;
    scroll-snap-align: center;
    opacity: 0;
    transform: scale(0.5);
    transition:
      opacity 0.45s ease,
      transform 0.25s ease,
      box-shadow 0.25s ease;
    transition-delay: calc(var(--i) * 55ms);
  }
  .reveal.is-visible .journey-step {
    opacity: 1;
    transform: scale(1);
  }
  .journey-step.is-active .journey-badge {
    box-shadow:
      0 0 0 6px color-mix(in srgb, var(--accent) 20%, transparent),
      0 6px 16px color-mix(in srgb, var(--accent) 65%, transparent);
    transform: scale(1.18);
  }
  .journey-line {
    position: absolute;
    top: 16px;
    left: 50%;
    width: 100%;
    height: 2px;
    background: var(--border);
    z-index: 0;
    transition: background 0.5s ease;
  }
  .reveal.is-visible .journey-line {
    background: var(--accent);
  }
  .journey-badge {
    width: 34px;
    height: 34px;
    border-radius: 999px;
    background: var(--accent);
    color: #fff;
    font-size: 13px;
    font-weight: 800;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 1;
    position: relative;
    transition:
      transform 0.25s ease,
      box-shadow 0.25s ease;
  }
  .journey-label {
    font-size: 12.5px;
    font-weight: 600;
  }
  .fade-edge {
    position: absolute;
    top: 0;
    bottom: 8px;
    width: 20px;
    pointer-events: none;
  }
  .fade-edge-left {
    left: 0;
    background: linear-gradient(90deg, var(--bg), transparent);
  }
  .fade-edge-right {
    right: 0;
    background: linear-gradient(270deg, var(--bg), transparent);
  }

  .buildpublic-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 14px;
  }
  .bip-card {
    border-radius: 14px;
    overflow: hidden;
    background: var(--surface);
    border: 1px solid var(--border);
    transition: box-shadow 0.25s ease;
    animation: fadeUp 0.5s ease both;
    animation-delay: calc(var(--i) * 55ms);
  }
  .bip-card:hover {
    box-shadow: 0 10px 24px rgba(15, 23, 42, 0.1);
  }
  .bip-image {
    width: 100%;
    aspect-ratio: 16 / 9;
    border-bottom: 1px dashed var(--border);
    position: relative;
  }
  .bip-label {
    padding: 12px 14px;
    font-size: 13px;
    font-weight: 700;
  }

  .services-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 14px;
  }
  .service-card {
    padding: 20px;
    border-radius: 16px;
    background: var(--surface);
    border: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    gap: 14px;
    transition:
      box-shadow 0.25s ease,
      border-color 0.2s ease;
    animation: fadeUp 0.5s ease both;
    animation-delay: calc(var(--i) * 55ms);
  }
  .service-card:hover {
    box-shadow: 0 10px 22px rgba(15, 23, 42, 0.08);
    border-color: var(--accent);
  }
  .service-icon {
    width: 40px;
    height: 40px;
    border-radius: 11px;
    background: var(--chip);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--accent);
  }
  .service-icon svg {
    width: 20px;
    height: 20px;
  }
  .service-label {
    font-weight: 700;
    font-size: 14px;
  }

  .values-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 16px 20px;
  }
  .value-item {
    display: flex;
    align-items: center;
    gap: 12px;
    animation: fadeUp 0.5s ease both;
    animation-delay: calc(var(--i) * 55ms);
  }
  .value-check {
    width: 32px;
    height: 32px;
    border-radius: 999px;
    background: var(--accent);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .value-label {
    font-weight: 600;
    font-size: 14px;
  }

  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .faq-item {
    border-radius: 14px;
    background: var(--surface);
    border: 1px solid var(--border);
    overflow: hidden;
    animation: fadeUp 0.5s ease both;
    animation-delay: calc(var(--i) * 55ms);
  }
  .faq-question {
    cursor: pointer;
    padding: 15px 18px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-weight: 700;
    font-size: 14px;
    list-style: none;
  }
  .faq-question::-webkit-details-marker {
    display: none;
  }
  .faq-icon {
    opacity: 0.5;
    font-size: 16px;
    transition: transform 0.25s ease;
    flex-shrink: 0;
    margin-left: 12px;
  }
  .faq-item[open] .faq-icon {
    transform: rotate(45deg);
  }
  .faq-answer {
    padding: 0 18px 16px;
    font-size: 13.5px;
    color: var(--muted);
    line-height: 1.6;
  }

  .closing-wrap {
    max-width: 880px;
    margin: 0 auto;
    padding: 0 clamp(16px, 5vw, 24px) 40px;
    text-align: center;
  }
  .closing-card {
    border-radius: 20px;
    background: var(--surface);
    border: 1px solid var(--border);
    padding: 32px 24px;
  }
  .closing-title {
    font-size: 18px;
    font-weight: 800;
    margin-bottom: 6px;
  }
  .closing-sub {
    font-size: 13.5px;
    color: var(--muted);
    margin-bottom: 18px;
  }

  .footer {
    border-top: 1px solid var(--border);
    padding: 32px 24px;
    text-align: center;
  }
  .footer-copy {
    font-size: 11.5px;
    color: var(--muted);
  }

  .back-to-top {
    position: fixed;
    bottom: 24px;
    right: 24px;
    width: 44px;
    height: 44px;
    border-radius: 999px;
    background: var(--accent);
    color: #fff;
    border: none;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 18px;
    cursor: pointer;
    box-shadow: 0 6px 18px rgba(15, 23, 42, 0.25);
    z-index: 60;
    transition: transform 0.2s ease;
  }
  .back-to-top:hover {
    transform: translateY(-3px);
  }
</style>

<script>
  const root = document.documentElement;

  const themeToggle = document.getElementById("theme-toggle")!;
  const savedTheme = localStorage.getItem("theme");
  if (savedTheme === "dark") {
    root.setAttribute("data-theme", "dark");
    themeToggle.textContent = "☀";
  }
  themeToggle.addEventListener("click", () => {
    const isDark = root.getAttribute("data-theme") === "dark";
    if (isDark) {
      root.removeAttribute("data-theme");
      themeToggle.textContent = "☾";
      localStorage.setItem("theme", "light");
    } else {
      root.setAttribute("data-theme", "dark");
      themeToggle.textContent = "☀";
      localStorage.setItem("theme", "dark");
    }
  });

  const searchInput = document.getElementById(
    "search-input",
  ) as HTMLInputElement;

  function filterList(
    input: string,
    items: NodeListOf<HTMLElement>,
    emptyEl: HTMLElement | null,
  ) {
    const q = input.trim().toLowerCase();
    let visible = 0;
    items.forEach((el) => {
      const match = !q || (el.dataset.filter || "").includes(q);
      el.style.display = match ? "" : "none";
      if (match) visible++;
    });
    if (emptyEl) emptyEl.hidden = visible !== 0;
  }
  const socialItems = document.querySelectorAll<HTMLElement>(".social-item");
  const productItems = document.querySelectorAll<HTMLElement>(".product-card");
  const socialEmpty = document.querySelector<HTMLElement>(
    '[data-role="social-empty"]',
  );
  const productsEmpty = document.querySelector<HTMLElement>(
    '[data-role="products-empty"]',
  );
  searchInput.addEventListener("input", () => {
    filterList(searchInput.value, socialItems, socialEmpty);
    filterList(searchInput.value, productItems, productsEmpty);
  });

  const revealEls = document.querySelectorAll<HTMLElement>("[data-reveal]");
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add("is-visible");
          observer.unobserve(entry.target);
          if (entry.target.getAttribute("data-reveal") === "journey")
            startJourneyLoop();
        }
      });
    },
    { threshold: 0.15, rootMargin: "0px 0px -10% 0px" },
  );
  revealEls.forEach((el) => observer.observe(el));

  const journeySteps = document.querySelectorAll<HTMLElement>(".journey-step");
  const journeyRunner = document.getElementById("journey-runner");
  const journeyTrack = document.getElementById("journey-track");
  const prefersReducedMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)",
  ).matches;
  function setActiveStep(i: number, jump = false) {
    journeySteps.forEach((el, idx) =>
      el.classList.toggle("is-active", idx === i),
    );
    const stepEl = journeySteps[i];
    if (journeyRunner && stepEl) {
      if (jump) journeyRunner.style.transition = "none";
      const center = stepEl.offsetLeft + stepEl.offsetWidth / 2;
      journeyRunner.style.left = `${center - 7}px`;
      if (jump) {
        void journeyRunner.offsetHeight;
        journeyRunner.style.transition = "";
      }
    }
    const track = journeyTrack;
    if (track && stepEl && track.scrollWidth > track.clientWidth) {
      const target = jump
        ? 0
        : stepEl.offsetLeft + stepEl.clientWidth / 2 - track.clientWidth / 2;
      track.scrollTo({
        left: Math.max(0, target),
        behavior: jump ? "instant" : "smooth",
      });
    }
  }
  function startJourneyLoop() {
    if (prefersReducedMotion || journeySteps.length === 0) {
      setActiveStep(0);
      return;
    }
    let i = 0;
    const tick = (jump = false) => {
      setActiveStep(i, jump);
      setTimeout(() => {
        const next = (i + 1) % journeySteps.length;
        const wrapped = next === 0;
        i = next;
        tick(wrapped);
      }, 1400);
    };
    tick(false);
  }

  const backToTop = document.getElementById("back-to-top")!;
  window.addEventListener(
    "scroll",
    () => {
      backToTop.hidden = window.scrollY <= 400;
    },
    { passive: true },
  );
  backToTop.addEventListener("click", () =>
    window.scrollTo({ top: 0, behavior: "smooth" }),
  );

  const latestVideoSlot = document.querySelector<HTMLElement>(
    '[data-slot="bip-0"]',
  );
  if (latestVideoSlot) {
    fetch("/api/latest-video.php")
      .then((res) => (res.ok ? res.json() : null))
      .then((data) => {
        if (!data || data.error || !data.thumbnailUrl) return;
        latestVideoSlot.classList.remove("placeholder");
        latestVideoSlot.innerHTML = "";
        latestVideoSlot.style.backgroundImage = `url(${data.thumbnailUrl})`;
        latestVideoSlot.style.backgroundSize = "cover";
        latestVideoSlot.style.backgroundPosition = "center";
        const card = latestVideoSlot.closest<HTMLElement>(".bip-card");
        if (card && data.videoUrl) {
          card.style.cursor = "pointer";
          card.addEventListener("click", () =>
            window.open(data.videoUrl, "_blank", "noopener"),
          );
        }
      })
      .catch(() => {});
  }
</script>
