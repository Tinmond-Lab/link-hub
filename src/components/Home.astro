---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "./home/Hero.astro";
import Works from "./home/Works.astro";
import Process from "./home/Process.astro";
import LatestVideo from "./home/LatestVideo.astro";
import About from "./home/About.astro";
import CommissionBand from "./home/CommissionBand.astro";
import Faq from "./home/Faq.astro";
import { faqJsonLd, organizationJsonLd } from "../seo/jsonld";
import type { Locale } from "../i18n/locales";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<BaseLayout
  locale={locale}
  path="/"
  jsonLd={[organizationJsonLd(locale), faqJsonLd(locale)]}
>
  <Hero locale={locale} />
  <Works locale={locale} />
  <Process locale={locale} />
  <LatestVideo locale={locale} />
  <About locale={locale} />
  <CommissionBand locale={locale} />
  <Faq locale={locale} />
</BaseLayout>
