---
interface Props {
  size?: number;
}

const { size = 20 } = Astro.props;
---

<svg
  viewBox="0 0 24 24"
  width={size}
  height={size}
  fill="none"
  stroke="currentColor"
  stroke-width="1.75"
  stroke-linejoin="round"
  stroke-linecap="round"
  aria-hidden="true"
>
  <rect x="3" y="5" width="18" height="14" rx="2"></rect>
  <path d="M4 7l8 6 8-6"></path>
</svg>
