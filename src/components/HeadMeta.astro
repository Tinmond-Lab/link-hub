---
import { getContent } from "../i18n/content";
import { mdPages, mdUrl } from "../seo/markdown";
import { SITE_URL, localePath, type Locale } from "../i18n/locales";

interface Props {
  locale: Locale;
  /** Locale-independent path of this page, e.g. "/" or "/commission/". */
  path?: string;
  title?: string;
  description?: string;
  image?: string;
  ogType?: string;
}

const {
  locale,
  path = "/",
  title,
  description,
  image,
  ogType = "website",
} = Astro.props;
const meta = getContent(locale).meta;
const pageTitle = title ?? meta.title;
const pageDescription = description ?? meta.description;
const pageUrl = `${SITE_URL}${localePath(locale, path)}`;
const hasMarkdown = mdPages().some(
  (p) => p.locale === locale && p.path === path,
);
const ogImage = image ?? `${SITE_URL}/og-image.jpg`;
---

<link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<title>{pageTitle}</title>
<meta name="description" content={pageDescription} />
<link rel="canonical" href={pageUrl} />
<link
  rel="alternate"
  hreflang="vi"
  href={`${SITE_URL}${localePath("vi", path)}`}
/>
<link
  rel="alternate"
  hreflang="en"
  href={`${SITE_URL}${localePath("en", path)}`}
/>
<link
  rel="alternate"
  hreflang="x-default"
  href={`${SITE_URL}${localePath("en", path)}`}
/>

{
  hasMarkdown && (
    <link rel="alternate" type="text/markdown" href={mdUrl(locale, path)} />
  )
}

<meta property="og:type" content={ogType} />
<meta property="og:site_name" content="Timond Lab" />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={pageDescription} />
<meta property="og:url" content={pageUrl} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:locale" content={meta.ogLocale} />
<meta property="og:locale:alternate" content={meta.ogAlternate} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={pageDescription} />
<meta name="twitter:image" content={ogImage} />
