---
import HeadMeta from "./HeadMeta.astro";
import { getContent } from "../i18n/content";
import { jsonLdScript } from "../seo/jsonld";
import { localePath, otherLocale, type Locale } from "../i18n/locales";

interface Props {
  locale: Locale;
  /** Locale-independent path of this page, e.g. "/commission/". */
  path: string;
  title: string;
  description: string;
  image?: string;
  jsonLd?: object[];
}

const { locale, path, title, description, image, jsonLd = [] } = Astro.props;
const t = getContent(locale).ui;
---

<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#1677ff" />
    <HeadMeta
      locale={locale}
      path={path}
      title={title}
      description={description}
      image={image}
    />
    {
      jsonLd.map((block) => (
        <script type="application/ld+json" set:html={jsonLdScript(block)} />
      ))
    }
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link
      href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      try {
        if (localStorage.getItem("theme") === "dark")
          document.documentElement.setAttribute("data-theme", "dark");
      } catch {
        // storage unavailable (private mode): keep the default light theme
      }
    </script>
  </head>
  <body>
    <header class="bar">
      <a class="back" href={localePath(locale)}>← {t.backHome}</a>
      <a
        class="pill"
        href={localePath(otherLocale(locale), path)}
        hreflang={otherLocale(locale)}
        aria-label={t.langAria}>{t.langLabel}</a
      >
    </header>
    <main class="page">
      <slot />
    </main>
    <footer class="foot">© 2026 Timond Lab</footer>
  </body>
</html>

<style is:global>
  :root {
    --bg: #f5f7fa;
    --surface: #ffffff;
    --text: #0f172a;
    --muted: #64748b;
    --border: #e3e7ed;
    --accent: #1677ff;
  }
  :root[data-theme="dark"] {
    --bg: #0f172a;
    --surface: #182238;
    --text: #f5f7fa;
    --muted: #94a3b8;
    --border: rgba(217, 217, 217, 0.14);
    --accent: #4c9aff;
  }
  * {
    box-sizing: border-box;
  }
  body {
    margin: 0;
    font-family:
      "Be Vietnam Pro",
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      sans-serif;
    background: var(--bg);
    color: var(--text);
    line-height: 1.6;
  }
  a {
    color: inherit;
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px clamp(12px, 4vw, 24px);
    border-bottom: 1px solid var(--border);
  }
  .back {
    font-weight: 600;
    text-decoration: none;
  }
  .pill {
    font-size: 12px;
    font-weight: 700;
    min-width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--surface);
    text-decoration: none;
  }
  .page {
    max-width: 760px;
    margin: 0 auto;
    padding: 32px clamp(16px, 4vw, 24px) 64px;
  }
  .page h1 {
    font-size: clamp(26px, 6vw, 36px);
    line-height: 1.2;
    margin: 0 0 12px;
  }
  .page h2 {
    font-size: 20px;
    margin: 32px 0 8px;
  }
  .page .lead {
    color: var(--muted);
    font-size: 17px;
    margin: 0 0 24px;
  }
  .card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 20px;
  }
  .btn {
    display: inline-block;
    padding: 12px 22px;
    border-radius: 999px;
    background: var(--accent);
    color: #fff;
    font-weight: 700;
    text-decoration: none;
  }
  .foot {
    text-align: center;
    color: var(--muted);
    font-size: 13px;
    padding: 24px;
  }
</style>
